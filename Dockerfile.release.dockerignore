# Only prepared application files enter release images. Development builds use .dockerignore.
*
!composer.json
!composer.lock
!package.json
!LICENSE
!AUTHORS
!CONTRIBUTORS.md
!docker-entrypoint.sh
!db-bootstrap
db-bootstrap/*
!db-bootstrap/monarc_structure.sql
!db-bootstrap/monarc_data.sql

!docker
docker/*
!docker/php
docker/php/*
!docker/php/monarc.ini

!config
config/*
!config/application.config.php
!config/autoload
config/autoload/*
!config/autoload/global.php
!config/autoload/*.php.dist

!vendor
!module
module/*
!module/Monarc
module/Monarc/*
!module/Monarc/Core
!module/Monarc/FrontOffice

!public
public/captcha
!deliveries
!data
data/*
!data/fonts

!scripts
scripts/*
!scripts/upgrade-db.sh
!tests
tests/*
!tests/released-sources.php
!tests/locked-doctrine.php
!tests/release-image.php

# Assets still link to these frontend sources; PHP loads their compiled translations.
!node_modules
node_modules/*
!node_modules/ng_anr
!node_modules/ng_client
# npm tooling and native build products are unnecessary after Grunt compilation.
node_modules/*/node_modules
!node_modules/ng_client/node_modules
node_modules/ng_client/node_modules/*
!node_modules/ng_client/node_modules/flag-icons

# Apply metadata exclusions even inside allowed dependency trees.
**/.git
**/.DS_Store
**/._*
**/*.cache
**/*.log
